{
  "name": "command-palette-search",
  "fixture": "rich",
  "size": "120x50",
  "actions": [
    {"key": ":"}, {"assert": {"overlay": "command_palette"}, "label": "palette-opens"},
    {"assert": {"no_layout_issues": true}, "label": "palette-fits-120x50"},
    {"text": "toggle"}, {"assert": {"contains": "Toggle"}, "label": "search-filters-to-toggles"},
    {"assert": {"no_layout_issues": true}, "label": "filtered-palette-fits"},
    {"key": "esc"}, {"assert": {"view": "Library"}, "label": "palette-dismissed"},
    {"key": ":"}, {"text": "refresh library"},
    {"assert": {"contains": "Rescan library"}, "label": "rescan-synonym"},
    {"assert": {"no_layout_issues": true}, "label": "synonym-fits"},
    {"resize": "60x15"},
    {"assert": {"contains": "Rescan library"}, "label": "synonym-visible-at-minimum"},
    {"assert": {"no_layout_issues": true}, "label": "synonym-fits-minimum"},
    {"key": "esc"}, {"key": ":"}, {"text": "eq"},
    {"assert": {"contains": "Toggle equalizer"}, "label": "eq-synonym"},
    {"assert": {"no_layout_issues": true}},
    {"key": "esc"}, {"key": ":"}, {"text": "tune radio"},
    {"assert": {"contains": "Tune Auto-DJ"}, "label": "radio-synonym"},
    {"assert": {"no_layout_issues": true}},
    {"key": "esc"}, {"key": ":"}, {"text": "errors"},
    {"assert": {"contains": "Show recent messages"}, "label": "errors-synonym"},
    {"assert": {"no_layout_issues": true}},
    {"key": "esc"}, {"key": ":"}, {"text": "restart song"},
    {"assert": {"contains": "Seek to start of track"}, "label": "restart-synonym"},
    {"assert": {"contains": "Load a track first"}, "label": "restart-still-requires-playback"},
    {"assert": {"no_layout_issues": true}},
    {"key": "esc"}, {"key": ":"}, {"text": "locate file"},
    {"assert": {"contains": "/music/alice/alpha/a1.flac"}, "label": "reveal-target"},
    {"assert": {"no_layout_issues": true}},
    {"key": "esc"}, {"key": ":"}, {"text": "Copy file path"},
    {"assert": {"contains": "/music/alice/alpha/a1.flac"}, "label": "copy-path-target"},
    {"assert": {"no_layout_issues": true}},
    {"key": "esc"}, {"key": ":"}, {"text": "Copy track info"},
    {"assert": {"contains": "Alice – Track A1"}, "label": "copy-info-target"},
    {"assert": {"no_layout_issues": true}},
    {"resize": "120x50"},
    {"assert": {"contains": "Alice – Track A1"}, "label": "copy-info-target-wide"},
    {"assert": {"no_layout_issues": true}}
  ]
}
