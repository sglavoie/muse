        "contains": "Repeat all \u00b7 Shuffle"
      }
    },
    {
      "assert": {
        "contains": "\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580"
      },
      "label": "large-cover"
    },
    {
      "assert": {
        "no_layout_issues": true
      }
    },
    {
      "resize": "72x18"
    },
    {
      "assert": {
        "contains": "Track G1"
      }
    },
    {
      "assert": {
        "no_layout_issues": true
      },
      "label": "compact-now-playing"
    },
    {
      "resize": "60x15"
    },
    {
      "assert": {
        "not_contains": "\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580\u2580"
