{
  "name": "insights-panels",
  "fixture": "rich",
  "size": "100x30",
  "actions": [
    {"key": "8"}, {"assert": {"view": "Insights"}}, {"wait": "500ms"},
    {"assert": {"no_layout_issues": true}, "label": "briefing"},
    {"assert": {"contains": "Artists to explore"}, "label": "coverage-body"},
    {"assert": {"contains": "all-time (fixed)"}, "label": "coverage-ignores-window"},
    {"key": "w"}, {"assert": {"status_contains": "always all-time"}, "label": "fixed-panel-says-so"},

    {"key": "`"}, {"assert": {"no_layout_issues": true}, "label": "rhythm"},
    {"assert": {"contains": "Hour of day"}, "label": "rhythm-hours"},
    {"key": "enter"}, {"wait": "300ms"},
    {"assert": {"contains": "Artist"}, "label": "hour-column-drills-to-its-tracks"},
    {"key": "esc"}, {"assert": {"contains": "Hour of day"}, "label": "back-to-rhythm"},

    {"key": "`"}, {"assert": {"no_layout_issues": true}, "label": "momentum"},
    {"assert": {"contains": "Month by month"}, "label": "momentum-months"},
    {"assert": {"contains": "silent"}, "label": "momentum-shows-dry-months"},
    {"assert": {"contains": "longest silence"}, "label": "momentum-dry-spell"},

    {"key": "`"}, {"assert": {"no_layout_issues": true}, "label": "concentration"},
    {"assert": {"contains": "Repertoire ladder"}, "label": "concentration-ladder"},
    {"assert": {"contains": "Top artists by time"}, "label": "concentration-top-artists"},
    {"assert": {"contains": "top 5 artists"}, "label": "concentration-top-five-share"},

    {"key": "`"}, {"assert": {"no_layout_issues": true}, "label": "time-vs-plays"},
    {"assert": {"contains": "by plays"}, "label": "time-vs-plays-count-ranking"},
    {"assert": {"contains": "by hours"}, "label": "time-vs-plays-hours-ranking"},
    {"assert": {"contains": "rank differently once time is counted"}, "label": "time-vs-plays-summary"},

    {"key": "`"}, {"assert": {"no_layout_issues": true}, "label": "sessions"},
    {"assert": {"contains": "<15m"}, "label": "sessions-duration-histogram"},
    {"assert": {"contains": "Session length"}, "label": "sessions-length-buckets"},
    {"assert": {"contains": "false start"}, "label": "sessions-false-starts"},
    {"key": "G"}, {"assert": {"contains": "Ends with"}, "label": "sessions-closers"},
    {"key": "k"}, {"key": "k"}, {"key": "k"}, {"assert": {"contains": "Opens with"}, "label": "sessions-openers"},
    {"key": "g"}, {"assert": {"contains": "All sessions"}, "label": "sessions-back-to-top"},
    {"key": "`"}, {"assert": {"no_layout_issues": true}, "label": "discovery"},
    {"assert": {"contains": "First heard"}, "label": "discovery-first-plays"},
    {"assert": {"contains": "Added but never played"}, "label": "discovery-backlog"},
    {"key": "enter"}, {"wait": "300ms"},
    {"assert": {"contains": "Artist"}, "label": "first-heard-month-drills-to-its-tracks"},
    {"key": "esc"}, {"assert": {"contains": "First heard"}, "label": "back-to-discovery"},

    {"key": "`"}, {"assert": {"no_layout_issues": true}, "label": "data-health"},
    {"key": "`"}, {"assert": {"contains": "Artists to explore"}, "label": "wraps-forward-to-coverage"},
    {"key": "~"}, {"assert": {"no_layout_issues": true}, "label": "wraps-back-to-data-health"},

    {"key": "`"}, {"key": "`"}, {"assert": {"contains": "‹w›"}, "label": "rhythm-honours-window"},
    {"key": "w"}, {"wait": "500ms"}, {"assert": {"contains": "7 Days"}, "label": "window-forward"},
    {"key": "W"}, {"wait": "500ms"}, {"assert": {"contains": "All Time"}, "label": "window-back"},

    {"resize": "60x15"}, {"assert": {"no_layout_issues": true}, "label": "briefing-drops-when-short"},
    {"resize": "100x30"}, {"assert": {"no_layout_issues": true}, "label": "restored"}
  ]
}
