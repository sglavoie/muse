    {"resize": "120x36"},
    {"assert": {"contains": "▄▃▅▆▆▇▆▆▅"}, "label": "strip-wide"},
    {"assert": {"no_layout_issues": true}},
    {"resize": "60x15"},
    {"assert": {"not_contains": "▆▆▇▆▆▅"}, "label": "strip-drops-out-first"},
    {"key": "L"},
    {"assert": {"contains": "Up next"}, "label": "sections-kept-when-strip-drops"},
    {"assert": {"not_contains": "▆▆▇▆▆▅"}, "label": "strip-still-out-without-lyrics"},
