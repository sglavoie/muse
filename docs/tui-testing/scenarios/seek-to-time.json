    {"assert": {"contains": "below 60"}},
    {"resize": "60x15"},
    {"assert": {"contains": "below 60"}},
    {"assert": {"no_layout_issues": true}},
    {"key": "esc"},
    {"assert": {"view": "Library"}},
    {"assert": {"no_layout_issues": true}}
  ]
}
