    {"assert": {"status_contains": "☾ 30m"}, "label": "countdown-in-status"},
    {"assert": {"no_layout_issues": true}},
    {"key": "3"},
    {"assert": {"status_contains": "☾ 30m"}, "label": "survives-view-change"},
    {"key": "I"},
    {"assert": {"contains": "☾ 30m"}, "label": "countdown-in-now-playing"},
    {"assert": {"no_layout_issues": true}},
    {"key": "esc"},
    {"key": "ctrl+n"},
